export const DEFAULT_PRAYER_LOCATION: PrayerLocationSettings = INDONESIA_CITIES[0]; // Jakarta

/**
 * Astronomical calculation of Islamic Prayer Times based on Kemenag RI standards:
 * - Subuh: -20 degrees below horizon
 * - Sunrise: -0.833 degrees
 * - Dzuhur: solar noon + 2-3 mins ihtiyat
 * - Ashar: Shafi'i shadow ratio 1:1
 * - Maghrib: sunset (-0.833 degrees) + 2 mins ihtiyat
 * - Isya: -18 degrees below horizon
 */
export function calculatePrayerTimes(
  date: Date = new Date(),
  latitude: number = DEFAULT_PRAYER_LOCATION.latitude,
  longitude: number = DEFAULT_PRAYER_LOCATION.longitude,
  timezone: number = DEFAULT_PRAYER_LOCATION.timezone
): PrayerTimes {
  const d = new Date(date);
  const year = d.getFullYear();
  const month = d.getMonth() + 1;
  const day = d.getDate();

  // Julian Day
  const a = Math.floor((14 - month) / 12);
  const y = year + 4800 - a;
  const m = month + 12 * a - 3;
  const jd =
    day +
    Math.floor((153 * m + 2) / 5) +
    365 * y +
    Math.floor(y / 4) -
    Math.floor(y / 100) +
    Math.floor(y / 400) -
    32045;

  const dJulian = jd - 2451545.0;

  // Mean anomaly of the sun
  const g = (357.529 + 0.98560028 * dJulian) % 360;
  const q = (280.459 + 0.98564736 * dJulian) % 360;
  const l = (q + 1.915 * Math.sin((g * Math.PI) / 180) + 0.02 * Math.sin((2 * g * Math.PI) / 180)) % 360;

  // Sun declination
  const e = 23.439 - 0.00000036 * dJulian;
  const sinDecl = Math.sin((e * Math.PI) / 180) * Math.sin((l * Math.PI) / 180);
  const decl = (Math.asin(sinDecl) * 180) / Math.PI;

  // Equation of time in minutes
  const yVal = Math.tan(((e / 2) * Math.PI) / 180) * Math.tan(((e / 2) * Math.PI) / 180);
  const eqt =
    (yVal * Math.sin((2 * q * Math.PI) / 180) -
      2 * 0.0167 * Math.sin((g * Math.PI) / 180) +
      4 * 0.0167 * yVal * Math.sin((g * Math.PI) / 180) * Math.cos((2 * q * Math.PI) / 180) -
      0.5 * yVal * yVal * Math.sin((4 * q * Math.PI) / 180)) *
    4 *
    (180 / Math.PI);

  // Solar noon in hours (Local time)
  const solarNoon = 12 + timezone - longitude / 15 - eqt / 60;

  const rad = Math.PI / 180;
  const phi = latitude * rad;
  const delta = decl * rad;

  // Hour angle helper
  const hourAngle = (angle: number) => {
    const cosH = (Math.sin(angle * rad) - Math.sin(phi) * Math.sin(delta)) / (Math.cos(phi) * Math.cos(delta));
    if (cosH > 1 || cosH < -1) return 0;
    return (Math.acos(cosH) * 180) / Math.PI;
  };

  // Subuh angle = -20 deg (Kemenag standard)
  const hFajr = hourAngle(-20);
  const fajrHours = solarNoon - hFajr / 15;

  // Sunrise angle = -0.833 deg
  const hSunrise = hourAngle(-0.833);
  const sunriseHours = solarNoon - hSunrise / 15;

  // Dzuhur: solar noon + 2 mins ihtiyat
  const dhuhrHours = solarNoon + 2 / 60;

  // Ashar: Shafi'i shadow = 1 + tan(abs(latitude - declination))
  const deltaDiff = Math.abs(latitude - decl);
  const asrAlt = (Math.atan(1 / (1 + Math.tan(deltaDiff * rad))) * 180) / Math.PI;
  const hAsr = hourAngle(asrAlt);
  const asrHours = solarNoon + hAsr / 15 + 2 / 60;

  // Maghrib: sunset (-0.833 deg) + 2 mins ihtiyat
  const sunsetHours = solarNoon + hSunrise / 15 + 2 / 60;

  // Isya angle = -18 deg (Kemenag standard) + 2 mins ihtiyat
  const hIsha = hourAngle(-18);
  const ishaHours = solarNoon + hIsha / 15 + 2 / 60;

  const formatHoursToHHMM = (hours: number): string => {
    let norm = (hours + 24) % 24;
    const h = Math.floor(norm);
    const m = Math.round((norm - h) * 60);
    const finalH = m === 60 ? (h + 1) % 24 : h;
    const finalM = m === 60 ? 0 : m;
    return `${String(finalH).padStart(2, '0')}:${String(finalM).padStart(2, '0')}`;
  };

  return {
    subuh: formatHoursToHHMM(fajrHours),
    terbit: formatHoursToHHMM(sunriseHours),
    dzuhur: formatHoursToHHMM(dhuhrHours),
    ashar: formatHoursToHHMM(asrHours),
    maghrib: formatHoursToHHMM(sunsetHours),
    isya: formatHoursToHHMM(ishaHours)
  };
}

/**
 * Returns info about the next incoming prayer time today
 */
export function getNextPrayer(times: PrayerTimes, currentTime: Date = new Date()): NextPrayerInfo {
  const currentMinutes = currentTime.getHours() * 60 + currentTime.getMinutes();

  const toMinutes = (timeStr: string) => {
    const [h, m] = timeStr.split(':').map(Number);
    return h * 60 + m;
  };

  const prayers = [
    { name: 'Subuh', time: times.subuh, mins: toMinutes(times.subuh) },
    { name: 'Terbit', time: times.terbit, mins: toMinutes(times.terbit) },
    { name: 'Dzuhur', time: times.dzuhur, mins: toMinutes(times.dzuhur) },
    { name: 'Ashar', time: times.ashar, mins: toMinutes(times.ashar) },
    { name: 'Maghrib', time: times.maghrib, mins: toMinutes(times.maghrib) },
    { name: 'Isya', time: times.isya, mins: toMinutes(times.isya) }
  ];

  for (const p of prayers) {
    if (p.mins > currentMinutes) {
      const diff = p.mins - currentMinutes;
      const h = Math.floor(diff / 60);
      const m = diff % 60;
      const countdownText = h > 0 ? `${h} jam ${m} mnt lagi` : `${m} menit lagi`;
      return {
        name: p.name,
        time: p.time,
        remainingMinutes: diff,
        countdownText,
        isPassedToday: false
      };
    }
  }

  // If all prayers passed today, next is tomorrow's Subuh
  const subuhMinsTomorrow = toMinutes(times.subuh) + 24 * 60;
  const diff = subuhMinsTomorrow - currentMinutes;
  const h = Math.floor(diff / 60);
  const m = diff % 60;
  return {
    name: 'Subuh (Besok)',
    time: times.subuh,
    remainingMinutes: diff,
    countdownText: `${h} jam ${m} mnt lagi`,
    isPassedToday: true
  };
}

/**
 * Computes an ISO week key (e.g. 2026-W43) or 2-week block key (e.g. 2026-2W21)
 * to reliably track completions for 1-week and 2-week recurring routines.
 */
export function getRoutineWeekKey(dateInput: Date | string = new Date(), interval: 1 | 2 = 1): string {
  const d = typeof dateInput === 'string' ? new Date(dateInput + 'T00:00:00') : new Date(dateInput);
  
  // ISO Week Number calculation
  const target = new Date(d.valueOf());
  const dayNr = (d.getDay() + 6) % 7; // Monday = 0, Sunday = 6
  target.setDate(target.getDate() - dayNr + 3);
  const firstThursday = target.valueOf();
  target.setMonth(0, 1);
  if (target.getDay() !== 4) {
    target.setMonth(0, 1 + ((4 - target.getDay() + 7) % 7));
  }
  const weekNum = 1 + Math.ceil((firstThursday - target.valueOf()) / 604800000);
  const year = target.getFullYear();

  if (interval === 2) {
    const biWeekNum = Math.ceil(weekNum / 2);
    return `${year}-2W${String(biWeekNum).padStart(2, '0')}`;
  }

  return `${year}-W${String(weekNum).padStart(2, '0')}`;
}

/**
 * Returns human-readable label for a weekly day index
 */
export function getWeeklyDayName(dayIndex?: number): string {
  const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
  if (typeof dayIndex === 'number' && dayIndex >= 0 && dayIndex <= 6) {
    return days[dayIndex];
  }
  return 'Setiap Pekan';
}
